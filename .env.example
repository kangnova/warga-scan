# Salin file ini menjadi .env.local lalu isi nilainya.

# 1. Database PostgreSQL (lokal atau Neon: https://neon.tech)
DATABASE_URL=postgresql://user:password@localhost:5432/app_saas

# 2. Gemini API Key — gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3. (Opsional) Override model vision Gemini
# GEMINI_MODEL=gemini-3.8-flash
