# Salin file ini menjadi .env.local lalu isi nilainya.

# ===== DATABASE (wajib untuk simpan data) =====
# Supabase: Project Settings → Database → Connection string (URI, session pooler)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== AI (wajib untuk ekstraksi) =====
# Gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== SUPABASE STORAGE (opsional — fallback disk lokal jika kosong) =====
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nama bucket (opsional, default: warga-scan-uploads)
# SUPABASE_STORAGE_BUCKET=warga-scan-uploads

# ===== OPSIONAL =====
# Override model vision Gemini
# GEMINI_MODEL=gemini-3.8-flash
# Anon key (hanya perlu jika nanti pakai Supabase Auth di sisi client)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
