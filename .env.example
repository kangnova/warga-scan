# Salin file ini menjadi .env.local lalu isi nilainya.

# ===== DATABASE (wajib untuk simpan data) =====
# Supabase: Project Settings → Database → Connection string (URI, session pooler)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# ===== AI PROVIDER (pilih salah satu) =====
# "gemini" (default) atau "openrouter" (endpoint OpenAI-compatible apa pun)
# AI_PROVIDER=gemini

# --- Jika AI_PROVIDER=gemini ---
# Gratis dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Jika AI_PROVIDER=openrouter ---
# API key dari https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# Default: https://openrouter.ai/api/v1 — arahkan ke Sumopod/vLLM/Ollama
# yang OpenAI-compatible jika perlu:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model vision, contoh: google/gemini-2.5-flash, qwen/qwen2.5-vl-72b-instruct
# AI_MODEL=google/gemini-2.5-flash
# Batas token output (default 16384) — model reasoning butuh headroom lebih
# AI_MAX_TOKENS=16384

# ===== SUPABASE STORAGE (opsional — fallback disk lokal jika kosong) =====
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Nama bucket (opsional, default: warga-scan-uploads)
# SUPABASE_STORAGE_BUCKET=warga-scan-uploads

# ===== OPSIONAL =====
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
